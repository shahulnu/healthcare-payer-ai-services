<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ummarali.payerai</groupId>
    <artifactId>payer-ai-services</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>hcc-engine-java</artifactId>
  <name>HCC Evidence Finder engine (Java)</name>
  <description>Spring Boot port of the HCC Evidence Finder: Claude MEAT chart review with code-owned HCC mapping, hierarchy and reconciliation.</description>

  <dependencies>
    <dependency>
      <groupId>com.ummarali.payerai</groupId>
      <artifactId>payer-ai-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Charts, the HCC map and recorded reviews are shared with the TypeScript engine. -->
      <resource>
        <directory>${project.basedir}/../data</directory>
        <includes>
          <include>hcc/*.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
