<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.ummarali.payerai</groupId>
  <artifactId>payer-ai-services</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Payer AI services</name>
  <description>Spring Boot services behind the portfolio demos, plus the code they share.</description>

  <modules>
    <module>payer-ai-common</module>
    <module>pa-engine-java</module>
    <module>appeals-engine-java</module>
    <module>benefits-engine-java</module>
    <module>pi-engine-java</module>
    <module>hcc-engine-java</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <anthropic.version>2.34.0</anthropic.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.anthropic</groupId>
        <artifactId>anthropic-java</artifactId>
        <version>${anthropic.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ummarali.payerai</groupId>
        <artifactId>payer-ai-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
